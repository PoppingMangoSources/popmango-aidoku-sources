#!/usr/bin/env bash
# Scope validation must happen before CI/toolchain shortcuts.
set -euo pipefail
tooling=$(cd "$(dirname "$0")/.." && pwd)
root=$(git rev-parse --show-toplevel)
updates=$(cat)
[ -n "$updates" ] || exit 0
printf '%s\n' "$updates" | python3 "$tooling/scripts/check-commits.py" --pre-push
python3 "$tooling/scripts/sync-agent-docs.py" --check
# Git exports GIT_DIR to hooks, most visibly in worktrees; the tests' own git commands in
# temporary repositories would otherwise write to the repository being pushed.
(cd "$tooling" && unset $(git rev-parse --local-env-vars) && python3 -m unittest discover -s scripts/tests -v)
python3 "$tooling/scripts/check-workflows.py" --offline
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ "$local_sha" =~ ^0+$ ]] && continue
    branch=${remote_ref#refs/heads/}
    case "$branch" in chore/*-before-rebuild-*) echo "Preserving snapshot $local_sha as $branch"; continue ;; esac
    source=$(python3 -c 'import runpy,sys; print(runpy.run_path(sys.argv[1])["source_for_branch"](sys.argv[2]) or "")' "$tooling/scripts/check-upstream-scope.py" "$branch")
    template=$(python3 -c 'import runpy,sys; print(runpy.run_path(sys.argv[1])["template_for_branch"](sys.argv[2]) or "")' "$tooling/scripts/check-upstream-scope.py" "$branch")
    # A template branch is scoped like a source branch, then every crate it changes is verified below.
    if [ -n "$source" ] || [ -n "$template" ]; then
        git fetch -q https://github.com/Aidoku-Community/sources.git main:refs/remotes/upstream/main
        python3 "$tooling/scripts/check-upstream-scope.py" --repo "$root" --head "$local_sha" --branch "$branch"
    fi
    # Validate the exact checkout that is being pushed, not an unrelated HEAD.
    [ "$local_sha" = "$(git rev-parse HEAD)" ] || { echo "Check out $local_ref before pushing so its source gates can run." >&2; exit 1; }
    if [ -n "$(git status --porcelain -- sources templates)" ]; then
        echo "Commit source/template changes before validating a push." >&2; exit 1
    fi
    if [ -n "$source" ]; then
        python3 "$tooling/scripts/check-sources.py" --repo "$root" --upstream "$source"
        "$tooling/scripts/verify-source.sh" "$root/sources/$source"
    else
        base=$remote_sha
        if [ -n "$template" ]; then
            # A template branch is built on upstream, so its crates are the ones it changes there.
            base=$(git merge-base HEAD refs/remotes/upstream/main)
        elif [[ "$base" =~ ^0+$ ]] || ! git cat-file -e "$base" 2>/dev/null; then
            base=$(git merge-base HEAD origin/main)
        fi
        crates=$(python3 "$tooling/scripts/changed-crates.py" --base "$base")
        while IFS= read -r crate; do
            [ -f "$root/$crate/Cargo.toml" ] || continue
            case "$crate" in
                sources/*)
                    "$tooling/scripts/verify-source.sh" "$root/$crate"
                    # The review_ tests make no requests, so unlike the live suite they can gate a push.
                    if [ -f "$root/$crate/src/test.rs" ]; then
                        command -v aidoku-test-runner >/dev/null || { echo "Install aidoku-test-runner to run $crate's review_ tests (AGENTS.md / CLAUDE.md section 1)." >&2; exit 1; }
                        (cd "$root/$crate"; cargo test -q review_)
                    fi
                    ;;
                templates/*) (cd "$root/$crate"; cargo fmt --check; cargo clippy --target wasm32-unknown-unknown -- -D warnings) ;;
            esac
        done <<< "$crates"
        python3 "$tooling/scripts/check-sources.py" --base "$base"
        if git diff --name-only "$base" "$local_sha" -- .github | grep -q .; then
            python3 "$tooling/scripts/check-workflows.py" --offline
        fi
    fi
done <<< "$updates"
echo "pre-push: all gates green"
