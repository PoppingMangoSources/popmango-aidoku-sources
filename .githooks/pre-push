#!/bin/sh
# Runs CI's gates for every source and template this push changes, so a red build is caught
# here rather than after main has published it. `git push --no-verify` skips them.
#
# Enable in a fresh clone with:  git config core.hooksPath .githooks

set -e

[ -z "$CI" ] || exit 0

root=$(git rev-parse --show-toplevel)
base=$(git merge-base HEAD origin/main 2>/dev/null || echo HEAD~1)
changed=$(git diff --name-only "$base" HEAD -- sources templates | cut -d/ -f1-2 | sort -u)

# The same commands as CI's lint and verify jobs.
for crate in $changed; do
	dir="$root/$crate"
	[ -f "$dir/Cargo.toml" ] || continue
	echo "pre-push: $crate"
	(
		cd "$dir"
		cargo fmt --check
		cargo clippy --target wasm32-unknown-unknown -- -D warnings
		case $crate in sources/*)
			RUSTFLAGS=-Dwarnings aidoku package >/dev/null
			aidoku verify package.aix
		esac
	)
done

python3 "$root/scripts/check-sources.py" --base "$base"
echo "pre-push: all gates green"
