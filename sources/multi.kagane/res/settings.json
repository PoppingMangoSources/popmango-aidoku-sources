					"content",
					"listings"
				]
			}
		]
	},
	{
		"type": "group",
		"title": "Hidden Tags",
		"footer": "Titles carrying any of these tags are left out of Discover, listings and browsing, but not out of a title search. Enter each tag's name as the site shows it.",
		"items": [
			{
