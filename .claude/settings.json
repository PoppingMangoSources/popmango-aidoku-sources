{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "^(Edit|MultiEdit|Write)$",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/agent-hooks.py\" pre-edit",
						"timeout": 10
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/agent-hooks.py\" stop",
						"timeout": 120
					}
				]
			}
		],
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bash \"${CLAUDE_PROJECT_DIR}/scripts/install-hooks.sh\"",
						"timeout": 10
					}
				]
			}
		]
	},
	"attribution": {
		"commit": "",
		"pr": "",
		"sessionUrl": false
	}
}
